<Application x:Class="Plainly.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Plainly.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
                <ResourceDictionary Source="Resources/Icons.xaml" />
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
            <conv:PercentToGridLengthConverter x:Key="PercentToGridLength" />
            <conv:IndexEqualsConverter x:Key="IndexEquals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
