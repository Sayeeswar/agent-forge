<UserControl x:Class="Plainly.Wpf.Views.UploadReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plainly.Wpf.ViewModels"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

    <DockPanel Background="{StaticResource BrushNeutral100}" LastChildFill="True">

        <Border DockPanel.Dock="Top" Padding="48,28,48,24" BorderThickness="0,0,0,2" BorderBrush="{StaticResource BrushDivider}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Upload a report" Style="{StaticResource H1}" VerticalAlignment="Bottom" />
                <TextBlock Grid.Column="1" Text="You can ask questions about it once it's ready" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="48,40">
            <StackPanel>

                <Grid Margin="0,0,0,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderThickness="2" BorderBrush="{StaticResource BrushNeutral600}"
                            Background="{StaticResource BrushBg}" Padding="48" MinHeight="280" Margin="0,0,32,0">
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDocument}" Width="44" Height="44" StrokeThickness="1.6" Margin="0,0,0,20" />
                            <TextBlock Text="Upload your medical report (PDF or photo)" FontSize="26" FontWeight="ExtraBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <TextBlock Text="Drag your file here, or choose it from your computer." Style="{StaticResource MutedText}" FontSize="18" TextWrapping="Wrap" Margin="0,0,0,20" />
                            <Button Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left" Command="{Binding ChooseFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUpload}" Width="20" Height="20" Stroke="{StaticResource BrushBg}" />
                                    <TextBlock Text="Choose file" Margin="10,0,0,0" FontSize="17" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="0,20,0,0">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLock}" Width="24" Height="24" HorizontalAlignment="Left" Margin="0,0,0,10" />
                        <TextBlock Text="Your reports are private and only used to answer your questions."
                                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,28" />
                        <TextBlock Text="Good to know" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8" />
                        <TextBlock Text="PDF files and clear photos (JPG or PNG) both work." Style="{StaticResource MutedText}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,4" />
                        <TextBlock Text="For photos, lay the page flat in good light." Style="{StaticResource MutedText}" FontSize="16" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Your recent reports" Style="{StaticResource H2}" Margin="0,0,0,12" />
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="236" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Report" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="1" Text="Added" Style="{StaticResource TableHeaderText}" />
                    <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource TableHeaderText}" />
                </Grid>
                <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UploadRowViewModel}">
                            <Grid Margin="0,18" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="236" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDocument}" />
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Added}" Style="{StaticResource MutedText}" FontSize="16" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="2" Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Uploading" FontSize="16" />
                                        <TextBlock Grid.Column="1" Foreground="{StaticResource BrushNeutral700}" FontSize="16">
                                            <Run Text="{Binding ProgressPercent, Mode=OneWay}" /><Run Text="%" />
                                        </TextBlock>
                                    </Grid>
                                    <Grid Height="6" Margin="0,8,0,0" Background="{StaticResource BrushNeutral300}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLength}}" />
                                            <ColumnDefinition Width="{Binding ProgressPercent, Converter={StaticResource PercentToGridLength}, ConverterParameter=inverse}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="{StaticResource BrushAccent}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClock}" Width="18" Height="18" />
                                    <TextBlock Text="Reading report…" FontSize="16" Margin="10,0,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCheck}" Width="18" Height="18" Stroke="{StaticResource BrushText}" />
                                    <TextBlock Text="Ready" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" />
                                </StackPanel>

                                <Button Grid.Column="3" Style="{StaticResource BtnGhost}" Content="Cancel" FontWeight="SemiBold"
                                        Foreground="{StaticResource BrushNeutral800}" HorizontalAlignment="Left"
                                        Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Grid.Column="3" Text="Usually takes under a minute" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center"
                                           Visibility="{Binding IsReading, Converter={StaticResource BoolToVis}}" />

                                <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                        Command="{Binding AskAboutThisReportCommand}"
                                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Ask about this report" Margin="0,0,10,0" />
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSend}" Width="16" Height="16" Stroke="{StaticResource BrushBg}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
