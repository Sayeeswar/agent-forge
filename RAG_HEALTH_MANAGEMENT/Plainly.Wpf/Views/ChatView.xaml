<UserControl x:Class="Plainly.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource BrushNeutral100}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="456" />
        </Grid.ColumnDefinitions>

        <!-- Main thread -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <Border DockPanel.Dock="Top" Padding="48,28,48,24" BorderThickness="0,0,0,2" BorderBrush="{StaticResource BrushDivider}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding CurrentSession.Title}" Style="{StaticResource H1}" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentSession.Time}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Bottom" />
                </Grid>
            </Border>

            <!-- Composer -->
            <Border DockPanel.Dock="Bottom" Padding="48,20,48,24" BorderThickness="0,2,0,0" BorderBrush="{StaticResource BrushDivider}" Background="{StaticResource BrushBg}">
                <StackPanel>
                    <Border Visibility="{Binding AttachedReportName, Converter={StaticResource StringToVis}}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushDivider}" BorderThickness="1.5" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDocument}" Width="18" Height="18" />
                                    <TextBlock Text="{Binding AttachedReportName}" FontWeight="SemiBold" Margin="10,0,10,0" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource BtnGhost}" Command="{Binding DetachReportCommand}" Padding="4" ToolTip="Remove report">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Report attached. Ask anything about it." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border BorderThickness="1.5" BorderBrush="{StaticResource BrushNeutral600}" Background="{StaticResource BrushNeutral100}" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource BtnSecondary}" Command="{Binding GoToUploadCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconAttach}" Width="18" Height="18" />
                                    <TextBlock Text="Attach a report" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Grid Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Type your question here…" Style="{StaticResource MutedText}" FontSize="18"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding QuestionInput, Converter={StaticResource EmptyStringToVis}}" />
                                <TextBox Style="{StaticResource InputBox}" BorderThickness="0" Background="Transparent"
                                         FontSize="18" VerticalContentAlignment="Center"
                                         Text="{Binding QuestionInput, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Command="{Binding SendQuestionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Send" Margin="0,0,8,0" />
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSend}" Width="16" Height="16" Stroke="{StaticResource BrushBg}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="48,0">
              <Grid>

                <!-- Main hardcoded HbA1c conversation (matches the source prototype, which does not data-drive this one) -->
                <StackPanel Visibility="{Binding IsMainSession, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,36,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="You asked" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="My blood report says my HbA1c is 6.8. What does that mean?"
                                   FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Border Style="{StaticResource DividerThin}" Margin="0,24,0,0" />

                    <Grid Margin="0,36,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Answer" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel Grid.Column="1" MaxWidth="680">
                            <TextBlock FontSize="19" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,22">
                                <Run Text="HbA1c is a blood test that shows your " />
                                <Run Text="average blood sugar over the past two to three months" FontWeight="SemiBold" />
                                <Run Text=". A result of 6.8% means your blood sugar has been higher than the usual range during that time." />
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Button Command="{Binding OpenCitationCommand}" CommandParameter="1" Content="1" Margin="4,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCitation1Active}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </InlineUIContainer>
                            </TextBlock>

                            <StackPanel Margin="0,0,0,22">
                                <Grid Height="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="57*" />
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition Width="35*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{StaticResource BrushNeutral300}" />
                                    <Border Grid.Column="1" Background="{StaticResource BrushNeutral500}" />
                                    <Border Grid.Column="2" Background="{StaticResource BrushNeutral800}" />
                                    <!-- Marker sits at 68% of the bar width, overlaid via a second proportional grid -->
                                    <Grid Grid.ColumnSpan="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68*" />
                                            <ColumnDefinition Width="32*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="3" HorizontalAlignment="Right" Background="{StaticResource BrushAccent}" />
                                    </Grid>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="57*" />
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition Width="35*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Below 5.7%&#10;Usual range" Style="{StaticResource MutedText}" FontSize="15" />
                                    <TextBlock Grid.Column="2" Text="6.5% and above&#10;Linked with diabetes" Style="{StaticResource MutedText}" FontSize="15" />
                                </Grid>
                                <TextBlock Margin="0,10,0,0" FontSize="15">
                                    <Run Text="5.7–6.4% is an in-between range. " Foreground="{StaticResource BrushNeutral700}" />
                                    <Run Text="Your result: 6.8%" Foreground="#AE1800" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>

                            <TextBlock FontSize="19" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,22">
                                <Run Text="According to your documents, a result of 6.5% or above is usually linked with diabetes. Your doctor will look at this result together with other tests before saying what it means for you." />
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Button Command="{Binding OpenCitationCommand}" CommandParameter="1" Content="1" Margin="4,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCitation1Active}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </InlineUIContainer>
                            </TextBlock>

                            <TextBlock FontSize="19" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,22">
                                <Run Text="This is a common result, and there is a lot you can do. Many people bring their HbA1c down with changes to food and daily activity, and sometimes with medicine." />
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Button Command="{Binding OpenCitationCommand}" CommandParameter="2" Content="2" Margin="4,0,0,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCitation2Active}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </InlineUIContainer>
                            </TextBlock>

                            <StackPanel Margin="0,16,0,0">
                                <Border Style="{StaticResource Divider}" Margin="0,0,0,16" />
                                <TextBlock Text="Where this answer came from" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
                                <Button Command="{Binding OpenCitationCommand}" CommandParameter="1" Style="{StaticResource BtnSecondary}"
                                        Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushDivider}"
                                        HorizontalContentAlignment="Left" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="26" BorderThickness="1.5" BorderBrush="{StaticResource BrushAccent}">
                                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Understanding Diabetes: A Patient Guide" FontSize="17" Margin="14,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Page 4" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button Command="{Binding OpenCitationCommand}" CommandParameter="2" Style="{StaticResource BtnSecondary}"
                                        Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushDivider}"
                                        HorizontalContentAlignment="Left" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="26" BorderThickness="1.5" BorderBrush="{StaticResource BrushAccent}">
                                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Living Well with Type 2 Diabetes" FontSize="17" Margin="14,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="Page 12" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="You could also ask" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
                                <WrapPanel>
                                    <Button Style="{StaticResource BtnSecondary}" FontWeight="Normal" Content="What can I do to lower it?" Margin="0,0,10,0" />
                                    <Button Style="{StaticResource BtnSecondary}" FontWeight="Normal" Content="What should I ask my doctor?" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Data-driven prior sessions -->
                <StackPanel Visibility="{Binding IsOtherSession, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,36,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="You asked" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentSession.Question}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Grid>
                    <Border Style="{StaticResource DividerThin}" Margin="0,24,0,0" />

                    <Grid Margin="0,36,0,40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Answer" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" />
                        <StackPanel Grid.Column="1" MaxWidth="680">
                            <ItemsControl ItemsSource="{Binding CurrentSession.Paragraphs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="19" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,22">
                                            <Run Text="{Binding Mode=OneWay}" />
                                            <InlineUIContainer BaselineAlignment="Center">
                                                <Button Content="1" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.OpenCitationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding DataContext.CurrentSession.SourceDocId, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsCurrentCitationActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </InlineUIContainer>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,16,0,0">
                                <Border Style="{StaticResource Divider}" Margin="0,0,0,16" />
                                <TextBlock Text="Where this answer came from" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
                                <Button Command="{Binding OpenCitationCommand}" CommandParameter="{Binding CurrentSession.SourceDocId}" Style="{StaticResource BtnSecondary}"
                                        Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrushDivider}"
                                        HorizontalContentAlignment="Left" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="26" BorderThickness="1.5" BorderBrush="{StaticResource BrushAccent}">
                                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding CurrentSourceDoc.Title}" FontSize="17" Margin="14,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding CurrentSourceDoc.PageLabel}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
              </Grid>
            </ScrollViewer>
        </DockPanel>

        <!-- Source panel -->
        <Border Grid.Column="1" BorderThickness="2,0,0,0" BorderBrush="{StaticResource BrushDivider}">
            <Grid>
                <Grid Visibility="{Binding HasSource, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="32,24,32,20" BorderThickness="0,0,0,2" BorderBrush="{StaticResource BrushDivider}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Source" Style="{StaticResource MutedText}" FontWeight="SemiBold" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsMainSession, Converter={StaticResource BoolToVis}}">
                                        <Button Content="1" Command="{Binding OpenCitationCommand}" CommandParameter="1" Margin="0,0,6,0" Width="34" Height="32">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCitation1Active}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="2" Command="{Binding OpenCitationCommand}" CommandParameter="2" Width="34" Height="32">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCitation2Active}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>

                                    <Button Content="1" Width="34" Height="32" Visibility="{Binding IsOtherSession, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding OpenCitationCommand}" CommandParameter="{Binding CurrentSession.SourceDocId}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource BtnCitation}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrentCitationActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushAccent}" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushNeutral100}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" Style="{StaticResource BtnSecondary}" Width="40" Height="40" Padding="0"
                                        HorizontalContentAlignment="Center"
                                        Command="{Binding CloseSourceCommand}" ToolTip="Close source">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" />
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding CurrentSourceDoc.Title}" Style="{StaticResource H2}" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding CurrentSourceDoc.Meta}" Style="{StaticResource MutedText}" FontSize="15" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,28" Background="{StaticResource BrushSurface}">
                        <Border Background="{StaticResource BrushNeutral100}" Padding="30,32">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentSourceDoc.PageLabel}" FontSize="13" Foreground="{StaticResource BrushNeutral700}"
                                           Margin="0,0,0,16" TextTrimming="None" />
                                <TextBlock Text="{Binding CurrentSourceDoc.Heading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CurrentSourceDoc.TextBefore}" Style="{StaticResource MutedText}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16" />
                                <Border Background="{StaticResource BrushAccent200}" Padding="14,12" Margin="0,0,0,16">
                                    <TextBlock Text="{Binding CurrentSourceDoc.HighlightedPassage}" FontSize="16" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Text="{Binding CurrentSourceDoc.TextAfter}" Style="{StaticResource MutedText}" FontSize="16" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="32,18" BorderThickness="0,2,0,0" BorderBrush="{StaticResource BrushDivider}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="16" Height="16" Background="{StaticResource BrushAccent200}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Highlighted text was used in the answer" Style="{StaticResource MutedText}" FontSize="15" TextWrapping="Wrap" />
                            </Grid>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource BtnGhost}" Content="Open full document" Command="{Binding GoToLibraryCommand}" />
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Visibility="{Binding NoSource, Converter={StaticResource BoolToVis}}" Margin="32,48">
                    <TextBlock Text="Source document" Style="{StaticResource H2}" />
                    <TextBlock Text="Select a numbered source in an answer to see exactly where the information came from."
                               Style="{StaticResource MutedText}" FontSize="17" TextWrapping="Wrap" MaxWidth="340" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
