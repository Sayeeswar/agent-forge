<UserControl x:Class="Plainly.Wpf.Views.DocumentLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Plainly.Wpf.ViewModels"
             xmlns:models="clr-namespace:Plainly.Wpf.Models">

    <DockPanel Background="{StaticResource BrushNeutral100}" LastChildFill="True">

        <Border DockPanel.Dock="Top" Padding="48,28,48,0" BorderThickness="0,0,0,2" BorderBrush="{StaticResource BrushDivider}">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Document Library" Style="{StaticResource H1}" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" Text="Everything the app uses to answer you" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Bottom" />
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="My Reports" Command="{Binding ShowReportsTabCommand}" Padding="0,14,22,16" FontSize="18">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="BorderThickness" Value="0,0,0,4" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReportsTabActive}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Health Documents" Command="{Binding ShowDocsTabCommand}" Padding="0,14,0,16" FontSize="18">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BtnBase}">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource BrushText}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Setter Property="BorderThickness" Value="0,0,0,4" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDocsTabActive}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushAccent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <Border Grid.Column="1" BorderThickness="1.5" BorderBrush="{StaticResource BrushNeutral600}" Background="{StaticResource BrushBg}"
                            Padding="14,0" VerticalAlignment="Bottom" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSearch}" Width="18" Height="18" />
                                <Grid Margin="10,0,0,0">
                                    <TextBlock Text="Search by name or illness" Style="{StaticResource MutedText}" FontSize="17"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding SearchQuery, Converter={StaticResource EmptyStringToVis}}" />
                                    <TextBox Style="{StaticResource InputBox}" BorderThickness="0" Background="Transparent"
                                             FontSize="17" VerticalContentAlignment="Center"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="48,32,48,40">
            <StackPanel>

                <!-- My Reports -->
                <StackPanel Visibility="{Binding IsReportsTabActive, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLock}" Width="20" Height="20" />
                            <TextBlock Text="Private to you" FontWeight="SemiBold" FontSize="16" Margin="10,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="· Only you can see these reports" Style="{StaticResource MutedText}" FontSize="16" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource BtnSecondary}" Command="{Binding GoToUploadCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}" Width="18" Height="18" />
                                <TextBlock Text="Upload a report" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="372" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Report" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="1" Text="Added" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="2" Text="Type" Style="{StaticResource TableHeaderText}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                    <ItemsControl ItemsSource="{Binding FilteredReports}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LibraryReportRowViewModel}">
                                <Grid Margin="0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="372" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconDocument}" />
                                        <TextBlock Text="{Binding Report.Name}" FontSize="18" FontWeight="SemiBold" Margin="14,0,0,0"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Report.Date}" Style="{StaticResource MutedText}" FontSize="16" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Style="{StaticResource TagNeutral}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Report.Type}" FontSize="14" />
                                    </Border>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                                        <Button Style="{StaticResource BtnPrimary}" Command="{Binding AskCommand}" CommandParameter="{Binding Report}" Margin="0,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Ask about this report" Margin="0,0,10,0" />
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSend}" Width="16" Height="16" Stroke="{StaticResource BrushBg}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource BtnSecondary}" Command="{Binding DeleteCommand}" CommandParameter="{Binding Report}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource IconPath}" Data="{StaticResource IconTrash}" Width="18" Height="18" />
                                                <TextBlock Text="Delete" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No reports match your search." Style="{StaticResource MutedText}" FontSize="17" Margin="0,28"
                               Visibility="{Binding NoReportsMatch, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Health Documents -->
                <StackPanel Visibility="{Binding IsDocsTabActive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="These are the documents the app answers from. Every answer tells you which one it used."
                               Style="{StaticResource MutedText}" FontSize="17" TextWrapping="Wrap" MaxWidth="720" Margin="0,0,0,24" />

                    <ItemsControl ItemsSource="{Binding FilteredGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:DocumentTopicGroup}">
                                <Grid Margin="0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" Style="{StaticResource Divider}" VerticalAlignment="Top" Margin="0,-12,0,0" />
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Topic}" FontSize="20" FontWeight="ExtraBold" />
                                        <TextBlock Text="{Binding CountLabel}" FontSize="15" Foreground="{StaticResource BrushNeutral700}" />
                                    </StackPanel>
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Documents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:DocumentEntry}">
                                                <Button Style="{StaticResource BtnSecondary}" Background="Transparent" BorderThickness="0,0,0,1"
                                                        BorderBrush="{StaticResource BrushDivider}" HorizontalContentAlignment="Stretch" Padding="0,14"
                                                        Command="{Binding DataContext.GoToChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="16" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Pages}" Style="{StaticResource MutedText}" FontSize="15" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No documents match your search." Style="{StaticResource MutedText}" FontSize="17" Margin="0,28"
                               Visibility="{Binding NoDocsMatch, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
