<Window x:Class="Plainly.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Plainly.Wpf.ViewModels"
        xmlns:views="clr-namespace:Plainly.Wpf.Views"
        Title="Plainly" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BrushBg}"
        FontFamily="{StaticResource FontBody}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UploadReportViewModel}">
            <views:UploadReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentLibraryViewModel}">
            <views:DocumentLibraryView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:SidebarView Grid.Row="0" Grid.Column="0" />

        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding CurrentViewModel}" />

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource BrushNeutral200}"
                BorderThickness="0,2,0,0" BorderBrush="{StaticResource BrushDivider}"
                Padding="28,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#9432;" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{StaticResource BrushNeutral800}" />
                <TextBlock Style="{StaticResource BodyText}" FontSize="15" Foreground="{StaticResource BrushNeutral800}"
                           Text="This tool provides information from uploaded documents and is not a medical diagnosis. Please consult a qualified doctor." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
